# Dockerfile generated by DevOpsArk

# Use the appropriate Node.js version based on the engines field in package.json
FROM node:20-slim AS builder

# Set the working directory
WORKDIR /app
# DevOpsArk Platform Layer: Zero-Touch OpenTelemetry & Console Logger (Node.js)
RUN npm install -g @opentelemetry/auto-instrumentations-node
ENV NODE_PATH="/usr/local/lib/node_modules"
ENV OTEL_TRACES_EXPORTER="otlp"
ENV OTEL_METRICS_EXPORTER="none"
ENV OTEL_LOGS_EXPORTER="otlp"
ENV OTEL_EXPORTER_OTLP_PROTOCOL="http/json"
ENV NODE_OPTIONS="--require @opentelemetry/auto-instrumentations-node/register --require /opt/devopsark/console-hook.cjs"

# Copy the package.json to install dependencies
COPY package.json ./

# Install dependencies for both backend and frontend
RUN npm install --prefix backend && npm install --prefix frontend

# Copy the full source code for the frontend
COPY . .

# Build the frontend application
RUN npm run build --prefix frontend

# Final stage to serve the built application
FROM nginx:alpine

# Copy the built frontend files to the nginx html directory
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Expose the port that nginx listens on
EXPOSE 80

# Command to run nginx
CMD ["nginx", "-g", "daemon off;"]