# Server
NODE_ENV=production
PORT=5001

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chat_db?retryWrites=true&w=majority

# Auth (use a strong random string, e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-strong-random-secret

# CORS (comma-separated origins without trailing slashes; leave empty for same-origin only)
CORS_ORIGIN=https://your-domain.com

# Cookie overrides (optional; auto-detected in production behind HTTPS proxy)
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true

# Cloudinary (required for profile pictures & image messages)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
